test_m10[[6]] |> mutate(rel_bias = (estimate - log(1.1)) / log(1.1) * 100) |> dplyr::select(rel_bias)
test_m30[[6]] |> mutate(rel_bias = (estimate - log(1.1)) / log(1.1) * 100) |> dplyr::select(rel_bias)
test_m30[[6]]
test_m10[[6]]
test_m30[[8]]
